{
  "name": "@docukit/docsync2",
  "version": "0.0.0-alpha.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "homepage": "https://docukit.dev/docsync",
  "repository": {
    "type": "git",
    "url": "https://github.com/docukit/docukit.git",
    "directory": "packages/docsync2"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf .next node_modules .turbo dist tsconfig.build.tsbuildinfo || rmdir /s /q .next node_modules .turbo dist tsconfig.build.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@docukit/docnode": "workspace:*",
    "@tanstack/query-core": "^5.101.0"
  },
  "peerDependenciesMeta": {
    "@docukit/docnode": {
      "optional": true
    }
  },
  "devDependencies": {
    "@docukit/docnode": "workspace:*",
    "@tanstack/query-core": "^5.101.0"
  },
  "exports": {
    ".": {
      "vitest": "./src/exports/shared.ts",
      "types": "./dist/src/exports/shared.d.ts",
      "default": "./dist/src/exports/shared.js"
    },
    "./*": {
      "vitest": "./src/exports/*.ts",
      "types": "./dist/src/exports/*.d.ts",
      "default": "./dist/src/exports/*.js"
    }
  },
  "keywords": [
    "sync",
    "local-first",
    "offline-first",
    "query",
    "document"
  ],
  "dependencies": {
    "idb": "^8.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "valibot": "^1.0.0"
  }
}
